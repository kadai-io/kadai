{
  "name": "kadai",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:hmr": "ng serve --hmr --no-live-reload",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "build:prod-silent": "ng build --configuration production --no-progress",
    "test": "ng test",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"**/*.{js,ts,css,scss,md,json,yml}\"",
    "format:html": "prettier --write \"**/*.{html,}\"",
    "e2e-dev": "cypress install && cypress run",
    "e2e-dev:open": "cypress install && cypress open",
    "e2e-standalone": "cypress install && cypress run --config-file cypress.config.ts"
  },
  "private": true,
  "dependencies": {
    "@ali-hm/angular-tree-component": "22.0.7",
    "@angular/animations": "22.2.4",
    "@angular/cdk": "22.2.6",
    "@angular/common": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/material": "22.2.6",
    "@angular/platform-browser": "22.2.4",
    "@angular/platform-browser-dynamic": "22.2.4",
    "@angular/router": "22.2.4",
    "@ngneat/hot-toast": "7.0.0",
    "@ngneat/overview": "8.1.0",
    "@ngxs/router-plugin": "22.0.0",
    "@ngxs/store": "22.0.0",
    "chart.js": "4.6.1",
    "ng2-charts": "11.0.0",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler": "22.2.4",
    "@angular/compiler-cli": "22.2.4",
    "@ngxs/devtools-plugin": "22.0.0",
    "@types/jsdom": "30",
    "@types/node": "26.6.6",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@vitest/coverage-v8": "5.1.0",
    "cypress": "16.2.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.7",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "sass": "1.108.0",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "resolutions": {
    "@jridgewell/sourcemap-codec": "1.6.0"
  },
  "packageManager": "yarn@4.18.1"
}
